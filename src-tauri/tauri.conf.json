{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨匣",
  "version": "2.0.0",
  "identifier": "com.moxia.novel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "墨匣 · 本地小说写作",
        "width": 1120,
        "height": 760,
        "minWidth": 560,
        "minHeight": 460,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "小说写作工具",
    "longDescription": "纯本地的极简小说写作 App：多书库、分卷章节树、Markdown 编辑器、实时双字数、手动/自动存档、MD/TXT/ZIP 导出、线格纸与密码锁，全部内容以 book.md 存在你自己的文件夹里。",
    "android": {
      "minSdkVersion": 24
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "dialog": {}
  }
}
